<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logo_application"
        android:label="Taller2"
        android:roundIcon="@mipmap/logo_application_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Taller2">

        <activity
            android:name="com.taller2.linearlayouts.ui.main.MainActivity"
            android:exported="false" />

        <activity
            android:name="com.taller2.linearlayouts.ui.auth.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.taller2.linearlayouts.ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name="com.taller2.linearlayouts.ui.inicio.HomeActivity"
            android:exported="false" />

        <activity
            android:name="com.taller2.linearlayouts.ui.inicio.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>